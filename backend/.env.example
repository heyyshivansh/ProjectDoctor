# Backend Environment Configuration Template
ENVIRONMENT=development
PROJECT_NAME="Project Doctor"
API_PREFIX=/api

# Database Configuration
# Production / Docker:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/project_doctor
# Local development fallback when PostgreSQL is not running:
# DATABASE_URL=sqlite:///./project_doctor.db

# Storage Configuration
STORAGE_LOCAL_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI Provider Selection: 'groq', 'openrouter', 'gemini', or 'mock'
AI_PROVIDER=groq

# Groq AI Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_MAX_OUTPUT_TOKENS=2500

# AI Context Budgeting Configuration
AI_INPUT_MAX_TOKENS=4500

# OpenRouter AI Configuration
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT_SECONDS=45.0
OPENROUTER_MAX_RETRIES=2

# Gemini AI Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
